{
  "name": "ops-command-center",
  "private": true,
  "description": "Real-time operations command center: live incidents, campus map and camera tiles — NestJS + React monorepo.",
  "license": "PolyForm-Strict-1.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "models:check": "node ops/model-tools/check.ts",
    "models:standins": "node ops/model-tools/make-standins.ts",
    "models:test": "node --test \"ops/model-tools/*.test.ts\"",
    "models:typecheck": "tsc --noEmit -p ops/model-tools",
    "keycloak:test": "node --test \"docker/keycloak/*.test.ts\"",
    "keycloak:typecheck": "tsc --noEmit -p ops/sign-in-backdrop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d postgres keycloak",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:stack:telemetry": "TELEMETRY_SOURCE=mqtt docker compose -f docker/docker-compose.yml --profile telemetry up --build --scale api=2",
    "docker:compose": "docker compose -f docker/docker-compose.yml",
    "docker:restart": "docker compose -f docker/docker-compose.yml up -d --force-recreate postgres keycloak",
    "docker:stack": "docker compose -f docker/docker-compose.yml up --build",
    "docker:stack:replicas": "docker compose -f docker/docker-compose.yml up --build --scale api=2",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:off": "bash scripts/ci-toggle.sh off",
    "ci:on": "bash scripts/ci-toggle.sh on",
    "ci:status": "bash scripts/ci-toggle.sh status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
