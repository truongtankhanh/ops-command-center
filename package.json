{
  "name": "ops-command-center",
  "private": true,
  "description": "Real-time operations command center: live incidents, campus map and camera tiles — NestJS + React monorepo.",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d postgres keycloak",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose up -d --force-recreate postgres keycloak",
    "docker:stack": "docker compose up --build",
    "docker:stack:replicas": "docker compose up --build --scale api=2",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:off": "bash scripts/ci-toggle.sh off",
    "ci:on": "bash scripts/ci-toggle.sh on",
    "ci:status": "bash scripts/ci-toggle.sh status"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
