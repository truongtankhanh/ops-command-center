        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU time per second, per replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 34,
        "w": 8,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
