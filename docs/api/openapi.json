          }
        },
        "required": ["cameraId", "label", "kind", "url"]
      },
      "CameraFieldOfViewDto": {
        "type": "object",
        "properties": {
          "heading": {
            "type": "number",
            "description": "Centre line of the view, in degrees clockwise from true north (0 ≤ heading < 360)",
            "minimum": 0,
            "maximum": 360,
            "example": 90
          },
          "angle": {
            "type": "number",
            "description": "Width of the view, in degrees (0 < angle ≤ 360)",
            "minimum": 0,
            "maximum": 360,
            "example": 90
          },
          "range": {
            "type": "number",
            "description": "How far the camera sees, in metres (> 0)",
            "minimum": 0,
            "example": 40
          }
        },
        "required": ["heading", "angle", "range"]
      },
      "CameraDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Camera id.",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "CAM-L01"
          },
          "name": {
            "type": "string",
            "example": "Library entrance"
          },
          "zoneId": {
            "type": "string",
            "description": "Zone the camera is mounted in.",
            "format": "uuid"
          },
          "position": {
            "description": "Mounting point as [lng, lat]",
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "online": {
            "type": "boolean",
            "description": "Whether the camera is currently online."
          },
          "fieldOfView": {
            "nullable": true,
            "description": "`null` when the orientation is not known; clients then draw no view",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/CameraFieldOfViewDto"
              }
            ]
          }
        },
        "required": ["id", "code", "name", "zoneId", "position", "online", "fieldOfView"]
      },
      "IncidentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Incident id.",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "INC-000042"
          },
          "type": {
            "description": "What happened.",
            "enum": [
              "intrusion",
              "fire_alarm",
              "equipment_fault",
              "medical",
              "crowding",
              "suspicious_object",
              "theft",
              "vandalism",
              "suspicious_person",
              "assault",
              "fire",
              "gas_leak",
              "hazmat_spill",
              "injury",
              "power_outage",
              "water_leak",
              "lift_entrapment",
              "hvac_fault",
              "network_outage",
              "severe_weather",
              "flooding",
              "fallen_tree",
              "traffic_accident",
              "blocked_access"
            ],
            "type": "string"
          },
          "severity": {
            "description": "From least to most urgent: `low`, `medium`, `high`, `critical`.",
            "enum": ["low", "medium", "high", "critical"],
            "type": "string"
          },
          "status": {
            "description": "`open`: not picked up yet. `acknowledged`: an operator is handling it. `resolved`: closed.",
            "enum": ["open", "acknowledged", "resolved"],
            "type": "string"
          },
          "title": {
            "type": "string",
            "example": "Door forced open — service corridor"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "zoneId": {
            "type": "string",
            "description": "Zone the incident is in.",
            "format": "uuid"
          },
          "position": {
            "description": "Location as [lng, lat]. The zone centre when none was given at report time.",
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "source": {
            "description": "`operator`: reported by a person. `simulator`: generated by the demo incident simulator.",
            "enum": ["operator", "simulator"],
            "type": "string"
          },
          "reportedAt": {
            "type": "string",
            "description": "When the incident was reported.",
            "format": "date-time"
          },
          "acknowledgedAt": {
            "type": "string",
            "nullable": true,
            "description": "When an operator acknowledged it. `null` until then.",
            "format": "date-time"
          },
          "resolvedAt": {
            "type": "string",
            "nullable": true,
            "description": "When it was resolved. `null` until then.",
            "format": "date-time"
          },
          "version": {
            "type": "integer",
            "description": "Starts at 1 and goes up by one on every change. Keep a cached copy unless this is higher.",
            "minimum": 1,
            "example": 3
          }
        },
        "required": [
          "id",
          "code",
          "type",
          "severity",
          "status",
          "title",
          "description",
          "zoneId",
          "position",
          "source",
          "reportedAt",
          "acknowledgedAt",
          "resolvedAt",
          "version"
        ]
      },
      "ActorDto": {
        "type": "object",
        "properties": {
          "kind": {
            "description": "`user`: a signed-in person. `system`: the API itself (simulator, demo seed, older entries).",
            "enum": ["user", "system"],
            "type": "string"
          },
          "subject": {
            "type": "string",
            "description": "The identity provider's subject for a user; `simulator`, `seed` or `system` otherwise.",
