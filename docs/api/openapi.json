    "/api/incidents": {
      "get": {
        "operationId": "IncidentsController_list",
        "parameters": [
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Only these statuses. Comma-separated (`open,acknowledged`) or repeated\n(`status=open&status=acknowledged`).",
            "schema": {
              "example": ["open", "acknowledged"],
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["open", "acknowledged", "resolved"]
              }
            }
          },
          {
            "name": "severity",
            "required": false,
            "in": "query",
            "description": "Only these severities: comma-separated or repeated, like `status`.",
            "schema": {
              "example": ["high", "critical"],
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["low", "medium", "high", "critical"]
              }
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of incidents returned.",
            "schema": {
              "minimum": 1,
              "maximum": 500,
              "default": 100,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IncidentDto"
