  "info": {
    "title": "Ops Command Center API",
    "description": "Incidents, zones, the site plan and cameras. Live updates on the `/events` Socket.IO namespace. Every endpoint needs an OIDC access token as `Authorization: Bearer <token>`; `/events` takes the same token in the handshake as `auth.token`. Writes need the `operator`, `supervisor` or `technician` role; a `technician` acknowledges and resolves only Facilities and Environment incidents. A token with none of `operator`, `supervisor`, `technician` and `viewer` gets 403.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "ApiErrorDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 404
          },
          "error": {
            "type": "string",
            "description": "HTTP status name",
            "example": "NOT_FOUND"
          },
          "message": {
            "description": "What went wrong. Validation failures list every problem as an array.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "example": "Incident 00000000-0000-0000-0000-000000000000 was not found"
          },
          "path": {
            "type": "string",
            "example": "/api/incidents/00000000-0000-0000-0000-000000000000"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["statusCode", "error", "message", "path", "timestamp"]
      },
      "ZoneDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Zone id.",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "BLD-LIB"
          },
          "name": {
            "type": "string",
            "example": "Library"
          },
          "kind": {
            "description": "What kind of area this is: a `building`, `parking` lot, campus `gate`, `outdoor` space,\n`sports` ground, `utility` area or `water`.",
            "enum": ["building", "parking", "gate", "outdoor", "sports", "utility", "water"],
            "type": "string"
          },
          "use": {
            "nullable": true,
            "description": "What a building is used for (ADR-0021). `null` for every other kind, and for a building whose\nuse is not set. Drives report-form suggestions only; restricts nothing.",
            "enum": [
              "academic",
              "library",
              "laboratory",
              "residential",
              "dining",
              "healthcare",
              "sports_hall",
              "administration",
              "data_center",
              "security_post",
              "utility_plant"
            ],
            "type": "string"
          },
          "polygon": {
            "type": "array",
            "description": "Closed ring of [lng, lat] points",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "center": {
            "description": "Centre as [lng, lat]. Used as the position of incidents reported without one.",
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": ["id", "code", "name", "kind", "use", "polygon", "center"]
      },
      "SitePolygonDto": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["Polygon"],
            "type": "string"
          },
          "coordinates": {
            "type": "array",
            "description": "Closed rings of [lng, lat] points, outer ring first",
            "items": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "required": ["type", "coordinates"]
      },
      "SiteLineStringDto": {
        "type": "object",
        "properties": {
          "type": {
            "enum": ["LineString"],
            "type": "string"
          },
          "coordinates": {
            "type": "array",
            "description": "[lng, lat] points, in order",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        },
        "required": ["type", "coordinates"]
      },
      "SiteFeatureDto": {
        "type": "object",
        "properties": {
          "part": {
            "description": "What this feature draws: the site `boundary`, a `road`, or a sports-`field` marking.",
            "enum": ["boundary", "road", "field"],
            "type": "string"
          },
          "geometry": {
            "description": "Shape depends on `type`",
            "oneOf": [
              {
                "$ref": "#/components/schemas/SitePolygonDto"
              },
              {
                "$ref": "#/components/schemas/SiteLineStringDto"
              }
            ],
            "discriminator": {
              "propertyName": "type",
              "mapping": {
                "Polygon": "#/components/schemas/SitePolygonDto",
                "LineString": "#/components/schemas/SiteLineStringDto"
              }
            }
          }
        },
        "required": ["part", "geometry"]
      },
      "SitePlanDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Site id.",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "LANGBIANG"
          },
          "name": {
            "type": "string",
            "example": "Langbiang Tech Campus"
          },
          "center": {
            "description": "Centre of the site as [lng, lat]: where a map opens",
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "number"
            }
          },
          "features": {
            "description": "Drawn under the zones, in drawing order. Building footprints and parking rows are not here: clients derive them from the zones.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SiteFeatureDto"
            }
          }
        },
        "required": ["id", "code", "name", "center", "features"]
      },
      "MockStreamDescriptorDto": {
        "type": "object",
        "properties": {
          "cameraId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "example": "CAM-L01 · Library entrance"
          },
          "kind": {
            "enum": ["mock"],
            "type": "string"
          },
          "seed": {
            "type": "number",
            "description": "Seed for the synthetic feed. A camera always gets the same seed, so its scene is stable."
          }
        },
        "required": ["cameraId", "label", "kind", "seed"]
      },
      "HlsStreamDescriptorDto": {
        "type": "object",
        "properties": {
          "cameraId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "example": "CAM-L01 · Library entrance"
          },
          "kind": {
            "enum": ["hls"],
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "HLS playlist URL",
            "example": "https://media.example.com/cam-l01/index.m3u8"
          }
        },
        "required": ["cameraId", "label", "kind", "url"]
      },
      "WebRtcStreamDescriptorDto": {
        "type": "object",
        "properties": {
          "cameraId": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "example": "CAM-L01 · Library entrance"
          },
          "kind": {
            "enum": ["webrtc"],
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri",
