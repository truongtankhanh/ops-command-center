# E2E only: copy to .env.test. Loaded instead of .env when NODE_ENV=test (Jest sets it); a real env var still wins.
# The suite drops and rebuilds the schema, so DB_NAME must end in _test.
# One-off, on the Compose Postgres:  docker compose exec postgres createdb -U postgres ops_test
DB_HOST=localhost
DB_PORT=15432
DB_NAME=ops_test
DB_USER=postgres
DB_PASSWORD=postgres
SIMULATOR_ENABLED=false
# mock | off. test/setup-env.ts sets off for every suite whatever this says; a telemetry suite turns it back on.
TELEMETRY_SOURCE=off
# Logs at warn by default in tests, so a run stays readable; raise it to debug one failing case (ADR-0014).
# LOG_LEVEL=warn
