# Copy to .env. Read from apps/api whatever the working directory; a variable set in the environment
# always wins over this file. Tests never read it: they use .env.test (see .env.test.example). ADR-0006.
PORT=13000
# Prometheus scrape endpoint, GET /metrics, on a port of its own; never proxied by nginx (ADR-0015).
# Must differ from PORT. Unset: 9464.
# METRICS_PORT=9464
# Required: development | test | production. Jest and the Docker image set it themselves.
NODE_ENV=development
# Lowest level logged: fatal | error | warn | info | debug | trace. Unset: debug here, warn in tests,
# info in production. Raise it for a while at runtime with `pnpm log-level` instead (ADR-0014).
# LOG_LEVEL=
# Stamped on every log line as `env`; a label, no behaviour. Unset: local here, test in tests.
# Production has no default: staging sets staging, production sets production (ADR-0014).
# DEPLOYMENT_ENV=
# Swagger UI + raw spec at /api/docs. Unset: on, except in production (ADR-0005).
# API_DOCS_ENABLED=
# Proxies trusted for the client address; 1 = the console's nginx, which overwrites the header (ADR-0012).
# Vite's dev proxy passes a client's own X-Forwarded-For through unchanged: no trust boundary in dev.
# TRUST_PROXY_HOPS=1
# Per-user rate limits. May be false here and in tests; production refuses false (ADR-0012).
# RATE_LIMIT_ENABLED=true
DATABASE_URL=postgres://postgres:postgres@localhost:15432/ops
# Sign-in through the Compose Keycloak: docker compose up -d postgres keycloak (ADR-0010).
# The issuer is the console dev server's origin, which proxies /auth to Keycloak; keys come from Keycloak directly.
OIDC_ISSUER=http://localhost:15173/auth/realms/occ
OIDC_JWKS_URL=http://localhost:18081/auth/realms/occ/protocol/openid-connect/certs
OIDC_AUDIENCE=occ-api
SEED_ON_BOOT=true
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=8000
# mock | mediamtx
CAMERA_SOURCE=mock
# MEDIAMTX_HLS_URL=http://localhost:8888
# MEDIAMTX_WEBRTC_URL=http://localhost:8889
# MEDIAMTX_PROTOCOL=hls
