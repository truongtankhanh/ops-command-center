{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "noEmit": true,
    // `vite.config.ts` imports `./vite.decoders.ts` with its extension, as Vite's native config loader needs.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "vite.config.ts", "vite.decoders.ts", "vite.decoders.test.ts"]
}
